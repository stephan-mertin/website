---
import Layout from "../layouts/Layout.astro";

const travelTypes = [
  "Urlaub",
  "Wochenendreise",
  "Fußball",
  "Konzert",
  "Motorsport",
  "Städtereise",
  "Meer",
  "Berge",
  "Familie besuchen",
  "Tagesausflug",
  "Eigenes Wunschziel",
];

const durations = ["Tagesausflug", "Wochenende", "3–5 Tage", "1 Woche", "Länger"];

const supportGroups = [
  { id: "A", title: "Ich bin weitgehend selbstständig", points: [
    "Ich kann mich selbstständig fortbewegen.",
    "Ich kann selbstständig an Gruppenaktivitäten teilnehmen.",
    "Ich benötige im Alltag und bei der Körperpflege keine regelmäßige Unterstützung.",
    "Ich kann selbstständig essen und trinken und benötige dabei keine Unterstützung.",
    "Besondere Unterstützung bei der Ernährung benötige ich nicht.",
  ] },
  { id: "B", title: "Ich bin selbstständig, brauche aber gelegentlich Unterstützung", points: [
    "Ich kann mich selbstständig fortbewegen.",
    "Ich kann problemlos an Gruppenaktivitäten teilnehmen.",
    "Im Alltag benötige ich grundsätzlich keine regelmäßige Unterstützung.",
    "Ich kann selbstständig essen und trinken.",
    "Gelegentliche Unterstützung, z. B. bei der Auswahl oder Vorbereitung von Speisen, kann hilfreich sein.",
  ] },
  { id: "C", title: "Ich benötige leichte Unterstützung", points: [
    "Ich habe leichte Einschränkungen bei der Fortbewegung, z. B. beim Treppensteigen.",
    "Ich kann mich mit einem Rollator weitgehend selbstständig bewegen.",
    "Bei einzelnen Tätigkeiten im Alltag oder bei der Körperpflege benötige ich Unterstützung.",
    "Bei den Mahlzeiten benötige ich möglicherweise Unterstützung, z. B. beim Kleinschneiden von Speisen.",
    "Ich kann grundsätzlich selbstständig essen und trinken.",
    "Ich kann am Reiseprogramm teilnehmen, benötige dabei aber ein angepasstes, eher ruhigeres Programm.",
  ] },
  { id: "D", title: "Ich benötige umfassende Unterstützung", points: [
    "Ich bin auf einen Rollstuhl angewiesen oder habe einen hohen bzw. umfassenden Unterstützungsbedarf.",
    "Ich benötige eine intensive Begleitung und gegebenenfalls besondere Überwachung.",
    "Ich kann aufgrund meiner Orientierung oder meines Unterstützungsbedarfs nicht längere Zeit alleine gelassen werden.",
    "Bei der Nahrungsaufnahme kann ein umfassender Unterstützungsbedarf bestehen.",
    "Mein individueller Unterstützungsbedarf sollte vor der Reise persönlich besprochen werden.",
  ] },
];
---

<Layout
  title="Persönliche Reisebegleitung anfragen | Reisekonfigurator"
  description="Planen Sie Ihre individuelle Reisebegleitung: Wünsche, Reiseziel und Zeitraum unverbindlich angeben. Stephan Mertin meldet sich persönlich bei Ihnen."
  page="configurator"
>
  <main>
    <section class="configurator" aria-labelledby="configurator-title">
      <header class="configurator-intro">
        <p class="eyebrow">Ihre Wünsche, Ihr Tempo</p>
        <h1 id="configurator-title">Reisekonfigurator</h1>
        <p>
          Erzählen Sie mir von Ihrer Wunschreise. Sie müssen noch nicht alles genau
          wissen – ich melde mich persönlich bei Ihnen.
        </p>
      </header>

      <form id="contact-form" class="configurator-form contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="172a40b3-f944-4b92-b437-2d147a603b79" />
        <input type="hidden" name="subject" value="Neue Anfrage über den Reisekonfigurator" />
        <input type="checkbox" name="botcheck" class="form-honeypot" tabindex="-1" autocomplete="off" />

        <fieldset class="configurator-step" data-configurator-step="1">
          <legend>1. Was möchten Sie erleben?</legend>
          <p class="step-intro">Mehrfachauswahl möglich.</p>
          <div class="choice-grid">
            {travelTypes.map((type) => (
              <label class="choice">
                <input
                  id={type === "Eigenes Wunschziel" ? "custom-destination-toggle" : undefined}
                  type="checkbox"
                  name="Art der Reise"
                  value={type}
                />
                <span>{type}</span>
              </label>
            ))}
          </div>
          <div id="custom-destination-wrap" class="custom-destination" aria-hidden="true">
            <div class="custom-destination-inner">
              <div class="form-field">
                <label for="custom-destination">Was möchten Sie erleben?</label>
                <input
                  id="custom-destination"
                  type="text"
                  name="Eigene Reiseidee"
                  placeholder="Beschreiben Sie kurz Ihre Idee"
                  disabled
                />
              </div>
            </div>
          </div>
          <div class="step-fields">
            <div class="form-field">
              <label for="destination">Gewünschtes Reiseziel</label>
              <div id="destination-wrap" class="destination-field is-open" aria-hidden="false">
                <div class="destination-field-inner">
                  <input id="destination" type="text" name="Gewünschtes Reiseziel" placeholder="z. B. Ostsee, Dresden, Stockholm"/>
                </div>
              </div>
            </div>
            <label class="choice destination-toggle">
              <input id="destination-unknown" type="checkbox" name="Reiseziel noch offen" value="Ja" />
              <span>Ich weiß noch nicht genau, wohin.</span>
            </label>
            <div class="form-field">
              <label for="message">Erzählen Sie mir mehr von Ihrem Wunsch</label>
              <textarea id="message" name="Nachricht" rows="6"></textarea>
            </div>
          </div>
        </fieldset>

        <fieldset class="configurator-step" data-configurator-step="2" hidden>
          <legend>2. Ihre Reiseidee</legend>
          <p class="step-intro">
          Wie lange möchten Sie unterwegs sein?
          </p>
          <div class="choice-grid">
            {durations.map((duration) => (
              <label class="choice">
                <input type="checkbox" name="Dauer" value={duration} />
                <span>{duration}</span>
              </label>
            ))}
          </div>
          <div class="configurator-fields step-fields">
            <div class="form-field">
              <div class="field-label-row">
                <label for="period">Gewünschter Zeitraum</label>
                <span class="info-hint">
                  <button class="info-hint-button" type="button" aria-label="Hinweis zum gewünschten Zeitraum" aria-describedby="period-hint" aria-expanded="false">i</button>
                  <span id="period-hint" class="info-hint-text" role="tooltip">
                    Sie können den Zeitraum grob oder bereits ganz genau angeben.
                  </span>
                </span>
              </div>
              <input id="period" type="text" name="Zeitraum" placeholder="z. B. Juni 2028, Frühling 2027" />
            </div>
            <div class="form-field">
              <label for="special-requests">Besondere Wünsche</label>
              <input id="special-requests" type="text" name="Besondere Wünsche" />
            </div>
          </div>
        </fieldset>

        <fieldset class="configurator-step" data-configurator-step="3" hidden>
          <legend>3. Meine Unterstützung</legend>
          <p class="step-intro">Bitte ordnen Sie sich einer Gruppe zu. Es ist nur eine Auswahl möglich.</p>
          <div class="support-groups">
            {supportGroups.map((group) => (
              <div class="support-group">
                <label class="choice support-group-choice">
                  <input type="radio" name="Unterstützungsgruppe" value={group.id} data-support-group={group.id} />
                  <span><strong>{group.id}</strong> – {group.title}</span>
                </label>
                <div class="support-details" data-support-details={group.id} aria-hidden="true">
                  <div class="support-details-inner">
                    <p>Welche Aussagen treffen auf Sie zu?</p>
                    {group.points.map((point) => (
                      <label class="support-point">
                        <input type="checkbox" name={`Merkmale Gruppe ${group.id}`} value={point} disabled />
                        <span>{point}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </fieldset>

        <fieldset class="configurator-step" data-configurator-step="4" hidden>
          <legend>4. Wie erreiche ich Sie?</legend>
          <div class="configurator-fields">
            <div class="form-field form-field-wide">
              <label for="name">Name</label>
              <input id="name" type="text" name="name" autocomplete="name" required />
            </div>
            <div class="form-field">
              <label for="phone">Telefonnummer</label>
              <input id="phone" type="tel" name="Telefonnummer" autocomplete="tel" />
            </div>
            <div class="form-field">
              <label for="email">E-Mail-Adresse</label>
              <input id="email" type="email" name="email" autocomplete="email" required />
            </div>
          </div>
        </fieldset>

        <button type="submit" hidden>Reisewunsch absenden</button>
        <p class="form-status" role="status" aria-live="polite" hidden></p>
      </form>
    </section>
  </main>

  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const customDestinationToggle = document.querySelector<HTMLInputElement>("#custom-destination-toggle");
    const customDestinationWrap = document.querySelector<HTMLElement>("#custom-destination-wrap");
    const customDestination = document.querySelector<HTMLInputElement>("#custom-destination");
    const destinationUnknown = document.querySelector<HTMLInputElement>("#destination-unknown");
    const destinationWrap = document.querySelector<HTMLElement>("#destination-wrap");
    const destination = document.querySelector<HTMLInputElement>("#destination");
    const steps = Array.from(document.querySelectorAll<HTMLFieldSetElement>("[data-configurator-step]"));
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const formStatus = form?.querySelector<HTMLElement>(".form-status");
    const unlockedSteps = new Set([1]);

    const revealStep = (stepNumber: number) => {
      if (unlockedSteps.has(stepNumber)) return;

      const step = steps.find((item) => Number(item.dataset.configuratorStep) === stepNumber);
      if (!step) return;

      unlockedSteps.add(stepNumber);
      step.hidden = false;
      step.classList.add("is-revealing");
      step.addEventListener("animationend", () => step.classList.remove("is-revealing"), { once: true });

      if (stepNumber === 4) {
        if (submitButton) submitButton.hidden = false;
        if (formStatus) formStatus.hidden = false;
      }
    };

    const updateStepProgress = () => {
      const hasTravelType = form?.querySelector<HTMLInputElement>('input[name="Art der Reise"]:checked');
      const hasDuration = form?.querySelector<HTMLInputElement>('input[name="Dauer"]:checked');
      const hasSupportGroup = form?.querySelector<HTMLInputElement>('input[name="Unterstützungsgruppe"]:checked');

      if (hasTravelType) revealStep(2);
      if (unlockedSteps.has(2) && hasDuration) revealStep(3);
      if (unlockedSteps.has(3) && hasSupportGroup) revealStep(4);
    };

    const updateCustomDestination = () => {
      const isOpen = customDestinationToggle?.checked ?? false;
      customDestinationWrap?.classList.toggle("is-open", isOpen);
      customDestinationWrap?.setAttribute("aria-hidden", String(!isOpen));
      if (customDestination) {
        customDestination.disabled = !isOpen;
        if (!isOpen) customDestination.value = "";
      }
    };

    customDestinationToggle?.addEventListener("change", updateCustomDestination);

    const updateDestination = () => {
      const isOpen = !(destinationUnknown?.checked ?? false);
      destinationWrap?.classList.toggle("is-open", isOpen);
      destinationWrap?.setAttribute("aria-hidden", String(!isOpen));
      if (destination) {
        destination.disabled = !isOpen;
        if (!isOpen) destination.value = "";
      }
    };

    destinationUnknown?.addEventListener("change", updateDestination);
    document.querySelectorAll<HTMLButtonElement>(".info-hint-button").forEach((button) => {
      button.addEventListener("click", () => {
        const isOpen = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!isOpen));
      });
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest(".info-hint")) return;
      document.querySelectorAll<HTMLButtonElement>(".info-hint-button[aria-expanded='true']")
        .forEach((button) => button.setAttribute("aria-expanded", "false"));
    });

    const updateSupportGroup = () => {
      const selectedGroup = document.querySelector<HTMLInputElement>("[data-support-group]:checked")?.dataset.supportGroup;
      document.querySelectorAll<HTMLElement>("[data-support-details]").forEach((details) => {
        const isOpen = details.dataset.supportDetails === selectedGroup;
        details.classList.toggle("is-open", isOpen);
        details.setAttribute("aria-hidden", String(!isOpen));
        details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((checkbox) => {
          checkbox.disabled = !isOpen;
          if (!isOpen) checkbox.checked = false;
        });
      });
    };

    document.querySelectorAll<HTMLInputElement>("[data-support-group]")
      .forEach((radio) => radio.addEventListener("change", updateSupportGroup));
    form?.addEventListener("reset", () => requestAnimationFrame(() => {
      unlockedSteps.clear();
      unlockedSteps.add(1);
      steps.forEach((step) => {
        const stepNumber = Number(step.dataset.configuratorStep);
        step.hidden = stepNumber !== 1;
        step.classList.remove("is-revealing");
      });
      if (submitButton) submitButton.hidden = true;
      if (formStatus) formStatus.hidden = true;
      updateCustomDestination();
      updateDestination();
      updateSupportGroup();
    }));
    form?.addEventListener("input", updateStepProgress);
    form?.addEventListener("change", updateStepProgress);
    updateCustomDestination();
    updateDestination();
    updateSupportGroup();

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>(".form-status");
      if (!submitButton || !status) return;

      const originalText = submitButton.textContent;
      submitButton.textContent = "Wird gesendet …";
      submitButton.disabled = true;
      status.textContent = "";
      status.className = "form-status";

      try {
        const response = await fetch(form.action, { method: "POST", body: new FormData(form) });
        const data = await response.json();
        if (!response.ok || !data.success) {
          throw new Error(data.message || "Die Anfrage konnte nicht gesendet werden.");
        }
        status.textContent = "Vielen Dank! Ihr Reisewunsch wurde erfolgreich gesendet.";
        status.classList.add("form-status-success");
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error
          ? error.message
          : "Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut.";
        status.classList.add("form-status-error");
      } finally {
        submitButton.textContent = originalText;
        submitButton.disabled = false;
      }
    });
  </script>
</Layout>
