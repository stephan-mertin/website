---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = Astro.site ?? Astro.url;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": new URL("/#business", siteUrl).href,
      name: "Begleitet Reisen",
      url: new URL("/", siteUrl).href,
      logo: new URL("/logo.jpeg", siteUrl).href,
      image: new URL("/Screenshot_20261031_154829_ChatGPT.jpg", siteUrl).href,
      description:
        "Persönliche Reisebegleitung für Menschen mit Handicap durch Stephan Mertin.",
      telephone: "+49 172 4361676",
      email: "begleitetreisen@gmail.com",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Angerstraße 13",
        postalCode: "90762",
        addressLocality: "Fürth",
        addressCountry: "DE",
      },
      founder: { "@id": new URL("/#stephan-mertin", siteUrl).href },
    },
    {
      "@type": "Person",
      "@id": new URL("/#stephan-mertin", siteUrl).href,
      name: "Stephan Mertin",
      jobTitle: "Reisebegleiter",
      image: new URL("/Screenshot_20261031_154829_ChatGPT.jpg", siteUrl).href,
      worksFor: { "@id": new URL("/#business", siteUrl).href },
    },
  ],
};
---

<Layout
  title="Reisebegleitung für Menschen mit Handicap | Begleitet Reisen"
  description="Persönliche Reisebegleitung für Menschen mit Handicap: Urlaubsreisen, Ausflüge und Veranstaltungen mit Stephan Mertin und 35 Jahren Erfahrung."
  page="home"
  image="/Screenshot_20261031_154829_ChatGPT.jpg"
  imageAlt="Stephan Mertin, persönlicher Reisebegleiter"
  schema={schema}
>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Gemeinsam die Welt entdecken</p>
        <h1 id="hero-title">Begleitet<br /><em>Reisen.</em></h1>
        <p class="hero-intro">
          Persönliche Reisebegleitung für Menschen mit Handicap – aufmerksam,
          erfahren und so individuell wie Ihre Wünsche.
        </p>
      </div>
      <figure class="portrait-wrap">
        <img
          class="portrait"
          src={`${base}/Screenshot_20261031_154829_ChatGPT.jpg`}
          alt="Stephan Mertin"
          width="1277"
          height="1536"
        />
        <figcaption>
          <span>Stephan Mertin</span>
          <span>Ihr Reisebegleiter</span>
        </figcaption>
      </figure>
    </section>

    <section class="about section-grid" aria-labelledby="about-title">
      <div>
        <h2 id="about-title">Reisen, die zu Ihnen passen.</h2>
      </div>
      <div class="section-copy">
        <p>
          Ich bin Stephan Mertin, staatlich anerkannter Erzieher und seit über
          35 Jahren in der Begleitung von Menschen mit Handicap tätig.
        </p>
        <p>
          Menschen zu begleiten, gemeinsame Erlebnisse zu ermöglichen und
          individuelle Wünsche Wirklichkeit werden zu lassen, ist für mich
          eine Herzensangelegenheit.
        </p>
        <p>
          Neben meiner pädagogischen Erfahrung bringe ich langjährige Kenntnisse
          im Sport mit. Zu meinen Qualifikationen gehören die DFB B-Lizenz
          Fußball sowie DOSB-Lizenzen im Rehabilitations- und Behindertensport.
        </p>
        <p>
          Ob Reise, Ausflug, Konzert oder Sportveranstaltung – ich möchte
          Menschen die Möglichkeit geben, Neues zu entdecken, Freude zu erleben
          und am gesellschaftlichen Leben teilzuhaben.
        </p>
        <p>
          <strong>Meine Überzeugung: Nicht die Einschränkung steht im Mittelpunkt,
          sondern der Mensch mit seinen Wünschen, Interessen und Möglichkeiten.</strong>
        </p>
      </div>
    </section>

    <section class="travel-program" aria-label="Reiseprogramm 2027">
      <img
        src={`${base}/reiseprogramm-2027.jpeg`}
        alt="Programm 2027: AIDA-Kreuzfahrten, Städtereisen nach Leipzig und Fürth, KARAT, Cavalluna, Sascha Grammel, DTM am Lausitzring und Fußballspiele."
        width="1080"
        height="902"
        loading="lazy"
        decoding="async"
      />
      <p class="travel-program-note">
        Interessieren Sie sich für KARAT, Cavalluna oder Sascha Grammel?
        Dann nehmen Sie einfach über den <a href={`${base}/reisekonfigurator/`}>Reisekonfigurator</a> Kontakt mit mir auf.
        Gemeinsam besprechen wir Ihre Wünsche und planen Ihren Besuch.
      </p>
    </section>

    <section class="offers" aria-labelledby="offers-title">
      <div class="offers-content">
        <div class="section-heading">
          <h2 id="offers-title">Was wir erleben können</h2>
        </div>
        <div class="offer-list">
          <article>
            <h3>Urlaubsreisen</h3>
            <p>Neue Orte entdecken, entspannen und die Reise sicher genießen.</p>
          </article>
          <article>
            <h3>Ausflüge</h3>
            <p>Spannende Ziele in der Nähe oder ein Wochenende in einer neuen Stadt.</p>
          </article>
          <article>
            <h3>Veranstaltungen</h3>
            <p>Fußball, Motorsport, Konzerte und andere besondere Erlebnisse.</p>
          </article>
          <article>
            <h3>Eigene Wünsche</h3>
            <p>Freunde oder Familie besuchen – gemeinsam machen wir es möglich.</p>
          </article>
        </div>
        <div class="offers-feature-image">
          <img
            src={`${base}/Screenshot_20261031_101332_ChatGPT.jpg`}
            alt="Reisebecher mit dem Logo von Stephan Mertin"
            width="1307"
            height="1307"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="mug-slogan"><em>Rüdiger aus Horka:<br />„Mein Tag beginnt erst, wenn die Tasse leer ist.“</em></p>
      </div>
    </section>

    <section class="process" aria-labelledby="process-title">
      <div class="process-heading">
        <p class="eyebrow">Schritt für Schritt</p>
        <h2 id="process-title">So läuft Ihre Reisebegleitung ab.</h2>
        <p>Vom ersten Gespräch bis zum gemeinsamen Rückblick – persönlich, transparent und in Ihrem Tempo.</p>
      </div>

      <div class="process-list">
        <article class="process-step process-step-blue">
          <div class="process-marker">
            <span class="process-number">01</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.3 3.5 10 6.9 8.4 9.2a14.2 14.2 0 0 0 6.4 6.4l2.3-1.6 3.4 2.7-.8 3c-.2.7-.8 1.2-1.5 1.2C10.1 20.9 3.1 13.9 3.1 5.8c0-.7.5-1.3 1.2-1.5l3-.8Z"/></svg>
          </div>
          <div class="process-copy">
            <h3>Kontakt aufnehmen</h3>
            <p>Sie melden sich bei mir über den Reisekonfigurator.</p>
          </div>
        </article>

        <div class="process-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v14m-6-6 6 6 6-6"/></svg></div>

        <article class="process-step process-step-green">
          <div class="process-marker">
            <span class="process-number">02</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-1a3 3 0 1 0 0-6m-13 15v-1.5A4.5 4.5 0 0 1 7 14h3a4.5 4.5 0 0 1 4.5 4.5V20m1.5-6h.8a4.7 4.7 0 0 1 4.7 4.7V20"/></svg>
          </div>
          <div class="process-copy">
            <h3>Kennenlerngespräch</h3>
            <p>Wir besprechen Ihre Wünsche, Motivation und Inhalte. Auf Wunsch mit gesetzlicher Betreuung oder anderen wichtigen Personen.</p>
          </div>
        </article>

        <div class="process-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v14m-6-6 6 6 6-6"/></svg></div>

        <article class="process-step process-step-gold">
          <div class="process-marker">
            <span class="process-number">03</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 11 1.8-4.5h10.4L19 11M4 11h16a1 1 0 0 1 1 1v5H3v-5a1 1 0 0 1 1-1Zm1 6v2m14-2v2M6.5 14h.01m10.99 0h.01"/></svg>
          </div>
          <div class="process-copy">
            <h3>Gemeinsame Tagestour</h3>
            <p>Wir unternehmen einen kleinen Ausflug, um uns in einer realen Situation besser kennenzulernen und die Chemie abzuklären.</p>
          </div>
        </article>

        <div class="process-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v14m-6-6 6 6 6-6"/></svg></div>

        <article class="process-step process-step-orange">
          <div class="process-marker">
            <span class="process-number">04</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Zm6-3v15m6-12v15"/><path d="M17.7 9.3a2.1 2.1 0 0 0-3 3L17 15l2.3-2.7a2.1 2.1 0 0 0-1.6-3Z"/></svg>
          </div>
          <div class="process-copy">
            <h3>Planung des Urlaubs</h3>
            <p>Gemeinsam planen wir das Reiseziel, den Zeitraum, die Anreise, die Unterkunft und die Aktivitäten – individuell und passend zu Ihren Wünschen und Bedürfnissen.</p>
          </div>
        </article>

        <div class="process-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v14m-6-6 6 6 6-6"/></svg></div>

        <article class="process-step process-step-purple">
          <div class="process-marker">
            <span class="process-number">05</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M5 7h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Zm3 0h8v14H8V7Z"/></svg>
          </div>
          <div class="process-copy">
            <h3>Durchführung der Reise</h3>
            <p>Jetzt beginnt der Urlaub – mit persönlicher Begleitung, Sicherheit und vielen gemeinsamen Erlebnissen.</p>
          </div>
        </article>

        <div class="process-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v14m-6-6 6 6 6-6"/></svg></div>

        <article class="process-step process-step-turquoise">
          <div class="process-marker">
            <span class="process-number">06</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.7 2.7L16.5 9"/></svg>
          </div>
          <div class="process-copy">
            <h3>Nachbereitung</h3>
            <p>Wir schauen gemeinsam zurück: Was war gut, was könnte beim nächsten Mal anders oder besser laufen? Auf Wunsch tauschen wir gerne Erinnerungen und Bilder aus.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="experience section-grid" aria-labelledby="experience-title">
      <div>
        <h2 id="experience-title">Schon erlebt.<br />Noch viel vor.</h2>
      </div>
      <div class="experience-cards">
        <article>
          <p class="card-label">Städte & Urlaub</p>
          <p>Dresden • Leipzig • Berlin • Stockholm</p>
        </article>
        <article>
          <p class="card-label">Sport</p>
          <p>Fußball:<br />
            RB Leipzig • FC Bayern München • Dynamo Dresden ▪︎ Energie Cottbus<br />
            Eishockey:<br />
            Crashers Chemnitz • Tornado Niesky<br />
            Motorsport:<br />
            DTM Lausitzring</p>
        </article>
        <article>
          <p class="card-label">Veranstaltungen</p>
          <p>Cavalluna (Pferdeshow):<br />
            • Tor zur Anderswelt (2025)<br />
            • Die Farben des Lebens (2026)<br />
            Musik:<br />
            • Dieter Maschine Birr mit Streichquintett<br />
            • Kathrin und Peter (Quirle-Häusl)</p>
        </article>
      </div>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <div class="contact-copy">
        <p class="eyebrow">Ihr Reisekonfigurator</p>
        <h2 id="contact-title">Wohin soll<br />es gehen?</h2>
        <p>
          Stellen Sie Ihre Wunschreise in wenigen Schritten zusammen. Sie müssen
          noch nicht alles genau wissen – ich melde mich anschließend persönlich bei Ihnen.
        </p>
        <a class="contact-cta" href={`${base}/reisekonfigurator/`}>Reise konfigurieren <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="classic-gallery" aria-labelledby="classic-gallery-title">
      <div class="classic-gallery-heading">
        <p class="eyebrow">Gemeinsame Erlebnisse</p>
        <h2 id="classic-gallery-title">Insel Classic 2026, Uhyst a.d. Spree</h2>
      </div>
      <div class="classic-gallery-grid">
        <button class="classic-thumb" type="button" data-image-src={`${base}/20260808_112211.jpg`} data-image-alt="Insel Classic 2026 – Bild 1">
          <img src={`${base}/20260808_112211.jpg`} alt="Insel Classic 2026 – Bild 1" loading="lazy" decoding="async" />
        </button>
        <button class="classic-thumb" type="button" data-image-src={`${base}/20260808_113132.jpg`} data-image-alt="Insel Classic 2026 – Bild 2">
          <img src={`${base}/20260808_113132.jpg`} alt="Insel Classic 2026 – Bild 2" loading="lazy" decoding="async" />
        </button>
        <button class="classic-thumb" type="button" data-image-src={`${base}/20260808_141513.jpg`} data-image-alt="Insel Classic 2026 – Bild 3">
          <img src={`${base}/20260808_141513.jpg`} alt="Insel Classic 2026 – Bild 3" loading="lazy" decoding="async" />
        </button>
        <button class="classic-thumb" type="button" data-image-src={`${base}/20260808_164155.jpg`} data-image-alt="Insel Classic 2026 – Bild 4">
          <img src={`${base}/20260808_164155.jpg`} alt="Insel Classic 2026 – Bild 4" loading="lazy" decoding="async" />
        </button>
      </div>
      <dialog class="classic-viewer" id="classic-viewer">
        <button class="classic-close-button" type="button" id="classic-viewer-close">Zurück zur Galerie</button>
        <img id="classic-viewer-image" src="" alt="" />
      </dialog>
    </section>

    <style>
      .classic-gallery {
        padding: clamp(2.5rem, 6vw, 4rem) max(1.25rem, calc((100% - 1120px) / 2));
        background: #f3f7fa;
      }
      .classic-gallery-heading {
        margin: 0 auto 1.5rem;
        text-align: center;
      }
      .classic-gallery-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.75rem;
        max-width: 900px;
        margin: 0 auto;
      }
      .classic-thumb {
        display: block;
        overflow: hidden;
        padding: 0;
        border: 0;
        border-radius: 10px;
        background: #e5ebf0;
        cursor: zoom-in;
      }
      .classic-thumb img {
        display: block;
        width: 100%;
        height: 125px;
        object-fit: cover;
      }
      .classic-viewer {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: 4.5rem 1rem 1rem;
        border: 0;
        background: rgb(0 0 0 / 92%);
      }
      .classic-viewer[open] {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .classic-viewer::backdrop {
        background: rgb(0 0 0 / 92%);
      }
      .classic-viewer > img {
        display: block;
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
      }
      .classic-close-button {
        position: fixed;
        top: max(1rem, env(safe-area-inset-top));
        right: 1rem;
        z-index: 2;
        min-height: 46px;
        padding: 0.75rem 1.1rem;
        border: 0;
        border-radius: 999px;
        background: #fff;
        color: #17324d;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
      }
      @media (max-width: 640px) {
        .classic-gallery-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .classic-thumb img {
          height: 110px;
        }
      }
    </style>

    <script>
      const photoViewer = document.getElementById("classic-viewer") as HTMLDialogElement | null;
      const photoViewerImage = document.getElementById("classic-viewer-image") as HTMLImageElement | null;
      const photoViewerClose = document.getElementById("classic-viewer-close") as HTMLButtonElement | null;

      document.querySelectorAll(".classic-thumb").forEach((button) => {
        button.addEventListener("click", () => {
          const src = button.getAttribute("data-image-src");
          const alt = button.getAttribute("data-image-alt") || "";
          if (!photoViewer || !photoViewerImage || !src) return;
          photoViewerImage.src = src;
          photoViewerImage.alt = alt;
          photoViewer.showModal();
        });
      });

      photoViewerClose?.addEventListener("click", () => photoViewer?.close());
      photoViewer?.addEventListener("click", (event) => {
        if (event.target === photoViewer) photoViewer.close();
      });
    </script>

  </main>
</Layout>
