---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const phoneDisplay = "0172 4361676";
const phoneHref = "+491724361676";
const email = "begleitetreisen@gmail.com";
---

<Layout
  title="Begleitet Reisen mit Stephan Mertin"
  description="Individuelle Reisebegleitung, Ausflüge und Freizeitaktivitäten mit über 30 Jahren Erfahrung."
  page="home"
>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Gemeinsam die Welt entdecken</p>
        <h1 id="hero-title">Begleitet<br /><em>Reisen.</em></h1>
        <p class="hero-intro">
          Persönliche Reisebegleitung für Menschen mit Handicap – aufmerksam,
          erfahren und so individuell wie Ihre Wünsche.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={`tel:${phoneHref}`}>Jetzt anrufen</a>
          <a class="button button-secondary" href={`mailto:${email}`}>E-Mail schreiben</a>
        </div>
      </div>
      <figure class="portrait-wrap">
        <img
          class="portrait"
          src={`${base}/stephan-mertin.jpeg`}
          alt="Stephan Mertin"
          width="1440"
          height="1438"
        />
        <figcaption>
          <span>Stephan Mertin</span>
          <span>Ihr Reisebegleiter</span>
        </figcaption>
      </figure>
    </section>

    <section class="about section-grid" aria-labelledby="about-title">
      <div>
        <h2 id="about-title">Reisen, die zu Ihnen passen.</h2>
      </div>
      <div class="section-copy">
        <p class="lead">
          Ich bin Stephan Mertin, Erzieher und seit über 30 Jahren in der
          Begleitung von Menschen mit Handicap tätig.
        </p>
        <p>
          Ob Urlaub, Wochenendausflug oder ein besonderes Erlebnis: Gemeinsam
          planen wir, was Ihnen Freude macht. Ihr Wohlbefinden, Ihr Tempo und
          Ihre persönlichen Wünsche stehen dabei im Mittelpunkt.
        </p>
      </div>
    </section>

    <section class="offers" aria-labelledby="offers-title">
      <div class="section-heading">
        <h2 id="offers-title">Was wir erleben können</h2>
      </div>
      <div class="offer-list">
        <article>
          <h3>Urlaubsreisen</h3>
          <p>Neue Orte entdecken, entspannen und die Reise sicher genießen.</p>
        </article>
        <article>
          <h3>Ausflüge</h3>
          <p>Spannende Ziele in der Nähe oder ein Wochenende in einer neuen Stadt.</p>
        </article>
        <article>
          <h3>Veranstaltungen</h3>
          <p>Fußball, Motorsport, Konzerte und andere besondere Erlebnisse.</p>
        </article>
        <article>
          <h3>Eigene Wünsche</h3>
          <p>Freunde oder Familie besuchen – gemeinsam machen wir es möglich.</p>
        </article>
      </div>
    </section>

    <section class="experience section-grid" aria-labelledby="experience-title">
      <div>
        <h2 id="experience-title">Schon erlebt.<br />Noch viel vor.</h2>
      </div>
      <div class="experience-cards">
        <article>
          <p class="card-label">Städte & Urlaub</p>
          <p>Dresden · Berlin · Stockholm</p>
        </article>
        <article>
          <p class="card-label">Sport</p>
          <p>RB Leipzig · FC Bayern München · Dynamo Dresden · Energie Cottbus</p>
        </article>
        <article>
          <p class="card-label">Veranstaltungen</p>
          <p>DTM Lausitzring · Cavalluna</p>
        </article>
        <a class="pdf-link" href={`${base}/begleitet-reisen-information.pdf`} target="_blank">
          <span>Informationsblatt ansehen</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <div class="contact-copy">
        <p class="eyebrow">Lassen Sie uns sprechen</p>
        <h2 id="contact-title">Wohin soll<br />es gehen?</h2>
        <p>
          Erzählen Sie mir von Ihrem Reisewunsch. Ich freue mich darauf,
          gemeinsam mit Ihnen die passende Begleitung zu planen.
        </p>
        <div class="contact-links">
          <a href={`tel:${phoneHref}`}>{phoneDisplay}</a>
          <a href={`mailto:${email}`}>{email}</a>
        </div>
      </div>

      <form id="contact-form" class="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input
          type="hidden"
          name="access_key"
          value="172a40b3-f944-4b92-b437-2d147a603b79"
        />
        <input type="hidden" name="subject" value="Neue Anfrage über Begleitet Reisen" />
        <input type="checkbox" name="botcheck" class="form-honeypot" tabindex="-1" autocomplete="off" />

        <div class="form-field">
          <label for="contact-name">Name</label>
          <input id="contact-name" type="text" name="name" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="contact-email">E-Mail-Adresse</label>
          <input id="contact-email" type="email" name="email" autocomplete="email" required />
        </div>
        <div class="form-field">
          <label for="contact-message">Ihre Nachricht</label>
          <textarea id="contact-message" name="message" rows="6" required></textarea>
        </div>
        <button type="submit">Nachricht senden</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>(".form-status");

      if (!submitButton || !status) return;

      const originalText = submitButton.textContent;
      submitButton.textContent = "Wird gesendet …";
      submitButton.disabled = true;
      status.textContent = "";
      status.className = "form-status";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
        });
        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.message || "Die Nachricht konnte nicht gesendet werden.");
        }

        status.textContent = "Vielen Dank! Ihre Nachricht wurde erfolgreich gesendet.";
        status.classList.add("form-status-success");
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error
          ? error.message
          : "Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut.";
        status.classList.add("form-status-error");
      } finally {
        submitButton.textContent = originalText;
        submitButton.disabled = false;
      }
    });
  </script>
</Layout>
