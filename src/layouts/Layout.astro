---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  page?: "home" | "legal" | "configurator";
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  page = "legal",
  image = "/logo.jpeg",
  imageAlt = "Logo von Begleitet Reisen",
  noindex = false,
  schema,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = `${base}/`;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(`${base}${image}`, siteUrl);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0c3b6d" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${base}/logo.jpeg`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Begleitet Reisen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {schema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    <title>{title}</title>
  </head>
  <body class:list={{ "legal-page": page === "legal" }}>
    <header class="site-header">
      <a class="brand" href={homeUrl} aria-label="Begleitet Reisen – Startseite">
        <img src={`${base}/logo.jpeg`} alt="" width="200" height="200" />
      </a>
      {page !== "home" ? (
        <a class="back-link" href={homeUrl}>Zurück zur Startseite</a>
      ) : (
        <div class="header-contact">
          <p><span>Persönlich begleitet</span>Über 30 Jahre Erfahrung</p>
          <a href={`${base}/reisekonfigurator/`}>Reise konfigurieren</a>
        </div>
      )}
    </header>

    <slot />

    <footer class="site-footer">
      <p>Begleitet Reisen · Stephan Mertin</p>
      <nav aria-label="Rechtliche Informationen">
        <a href={`${base}/impressum/`}>Impressum</a>
        <a href={`${base}/datenschutz/`}>Datenschutz</a>
      </nav>
    </footer>
  </body>
</html>
